static func pick(list: Array):
	return list[randi() % list.size()]


## 会話を表示用の文字列にする
static func talk_text(lines: Array) -> String:
	var out := PackedStringArray()
	for l in lines:
		out.append(("メイド「%s」" if l[0] == "M" else "ご主人様「%s」") % l[1])
	return "\n".join(out)
